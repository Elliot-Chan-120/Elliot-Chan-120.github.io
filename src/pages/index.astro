---
import Panel from "../components/panel.astro";
import Hero from "../components/Hero.astro";
import NanoMaker from "../components/NanoMaker.astro";
import NanoMaker_Proteins from "../components/NanoMaker_Proteins.astro";
import PRISMATIC from "../components/PRISMATIC.astro";
import BlueTuna_and_NOCTURNAL from "../components/BlueTuna_and_NOCTURNAL.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
const palette = siteConfig.palette;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>
  </head>
  <body>
    <section class="screen">
        <Panel
        maxWidth="1000px"
        barColor={palette.darksnow}
        accent={palette.darksnow}
        barthickness="0px"
      >
        <Hero />
      </Panel>
    </section>

    <div id="nanomaker"></div>
    <section class="screen">

      <Panel
        maxWidth="1100px"
        barColor={palette.polarnight1Color}
        accent={palette.snow3}
        barthickness="4px"
      >
        <NanoMaker />
      </Panel>
    </section>

    <div id="nanomaker_proteins"></div>
    <Panel
      maxWidth=90%
      barColor={palette.polarlight}
      accent={palette.auroraPurpleColor}
      barthickness="1px"
    >
      <NanoMaker_Proteins />
    </Panel>

    <div id="prismatic"></div>
    <section class="screen">
      <Panel
        maxWidth="1100px"
        barColor={palette.darksnow}
        accent={palette.darksnow}
        barthickness="1px"
      >
        <PRISMATIC />
      </Panel>
    </section>

    <div id="bluetuna_nocturnal"></div>
    <section class="screen">
      <Panel
        maxWidth="80%"
        barColor={palette.snowWhiteColor}
        accent={palette.snowWhiteColor}
        barthickness="None"
      >
        <BlueTuna_and_NOCTURNAL />
      </Panel>
    </section>
    <Footer />
  </body>
</html>
