---
import { siteConfig } from "../config";
const palette = siteConfig.palette;
---
<div class="proj-desc">&gt; initialize portfolio<span class="cursor">█</span></div>
<div class="grid">
  <div class="card">
    <div class="proj-name">Elliot Chan</div>
    <div class="proj-desc">Bioinformatician</div>

    <div class="nav-hub">
      <br />
      <a
        href="https://github.com/Elliot-Chan-120"
        class="contact_btn" target="_blank">
        GitHub
      </a>

      <a
        href="https://www.linkedin.com/in/elliot-chan-6206b01ba/"
        class="contact_btn"
        target="_blank">
        LinkedIn
      </a>

      <a
        href="mailto:e224chan@uwaterloo.ca"
        class="contact_btn"
        target="_blank">
        Email
      </a>

    </div>
  </div>
  <div class="card">
    <div class="nav-hub">
      [ navigation ]
      <br>
      <a href="#nanomaker" class="btn">
        <span class="arrow">&gt;</span> NanoMaker
      </a>

      <a href="#nanomaker_proteins" class="btn">
        <span class="arrow">&gt;</span> NanoMaker/visual preview
      </a>

      <a href="#prismatic" class="btn">
        <span class="arrow">&gt;</span> PRISMATIC
        </a>

      <a href="#bluetuna_nocturnal" class="btn"
        ><span class="arrow">&gt;</span> BlueTuna
        </a>

      <a href="#bluetuna_nocturnal" class="btn">
        <span class="arrow">&gt;</span> NOCTURNAL
      </a>
    </div>
  </div>
</div>

<div class="proj-id">&gt; whoami<span class="cursor">█</span></div>
<div class="card">
  <div class="body-paragraph">
    <p>
      I'm an Honors Biomedical Sciences graduate from the University of
      Waterloo, now in Toronto as a bioinformatician with an interest in machine
      and deep learning. I build systems bridging ML and biomedical science, addressing
      research problems with creative domain integration, feature engineering
      and machine learning.
      <br />
      <br />
      Outside of programming, I enjoy combat sports (Muay Thai & Boxing), 
      activities that boost overall physical well-being. I speak English, French,
      and Cantonese.
      <br />
      <br />
      Currently open to entry-level roles in bioinformatics, computational biology
      or ML Engineering.
    </p>
  </div>
</div>

<style>
  .card {
    --text-primary: #d8dee9;
    --text-secondary: #d8dee9;
    --accent: #45445a;
    border: 0px solid var(--accent);
    padding: 1rem;
    margin-left: 1rem;
    margin-right: 1rem;
    margin-bottom: 1rem;
    font-family: "IBM Plex Mono", monospace;
    animation: fadeIn 0.6s ease forwards;
    animation-fill-mode: both
  }

  .proj-desc {
  font-size: 16px;
  color: var(--text-secondary);
  line-height: 1.3;
  animation: fadeIn 0.2s;
  animation-fill-mode: both;
  animation-delay: 0.5s;
  }

  .grid .card:nth-child(1) { animation-delay: 1.5s; }
  .grid .card:nth-child(2) { animation-delay: 2.3s; }

  .proj-id {
  font-size: 16px;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  margin-bottom: 4px;
  animation: fadeIn 0.2s;
  animation-fill-mode: both;
  animation-delay: 3.2s;
  }

  .card { animation-delay: 4.2s; }

  .proj-name {
    font-size: 60px;
    font-weight: 700;
    color: #a7b5cd;
    margin-bottom: 6px;
  }
  .body-paragraph {
    font-size: 14px;
    color: var(--text-primary);
    letter-spacing: 0.1em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  }

  .btn {
    display: flex;
    justify-content: left;
    gap: 8px;
    padding: 8px 16px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-decoration: none;

    background: transparent;
    color:;
    border: 0px solid #4c566a;
    margin-top: -1px;

    transition:
      background 0.15s,
      color 0.15s;
  }

  .btn:hover {
    background: #2e3440;
    color: #a7b5cd;
  }

  .arrow {
    color: #81A1C1;
    transition: transform 0.15s;
  }

  .btn:hover .arrow {
    transform: translateX(7px);
  }

  .contact_btn {
    gap: 8px;
    padding: 8px 16px;
    font-family: "IBM Plex Mono", monospace;
    color: #a7b5cd;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-decoration: none;

    background: transparent;
    color:;
    border: 0px solid;
    width: 80px;
    margin-top: 8px;

    transition:
      background 0.15s,
      color 0.15s;

  }

  .contact_btn:hover {
    background: #a7b5cd;
    color: #2e3440; /* or var(--bg) if you set that variable */
  }

  .cursor {
    color: #d8dee9;
    animation: blink 1.4s step-end infinite;
    margin-left: 2px;
    animation-delay: 0.2s;
  }

  .nav-hub {
    font-size: 16px;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-10px); }
    to   { opacity: 1; }
  }
</style>
